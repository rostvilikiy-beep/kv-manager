{
  "manifest_version": 3,
  "name": "Leads Parser: Google Maps + Booksy + 2ГИС",
  "version": "4.9.3",
  "description": "Собирает телефоны, соцсети, рейтинг и отзывы заведений из Google Maps, Booksy и 2ГИС, отправляет их в программу рассылки, рассылает сообщения в Instagram, Facebook и ВКонтакте и собирает данные салона для конструктора сайтов.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://booksy.com/*",
    "https://*.booksy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leads Parser"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.pl/maps/*",
        "https://www.google.ru/maps/*",
        "https://www.google.de/maps/*",
        "https://www.google.com.ua/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "maps.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://booksy.com/*",
        "https://*.booksy.com/*"
      ],
      "js": [
        "booksy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://2gis.ru/*",
        "https://*.2gis.ru/*"
      ],
      "js": [
        "dgis-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://2gis.ru/*",
        "https://*.2gis.ru/*"
      ],
      "js": [
        "dgis.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://web.facebook.com/*",
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*",
        "https://vk.me/*",
        "https://*.vk.me/*"
      ],
      "js": [
        "social.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "adlib.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://booksy.com/*",
        "https://*.booksy.com/*",
        "https://www.google.com/maps/*",
        "https://www.google.pl/maps/*",
        "https://www.google.ru/maps/*",
        "https://www.google.de/maps/*",
        "https://www.google.com.ua/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
