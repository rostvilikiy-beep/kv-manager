# ---------- Обязательно ----------
# Токен бота-уведомлялки (получить у @BotFather)
BOT_TOKEN=123456:ABC...

# Твой Telegram ID (узнать у @userinfobot). Можно несколько через запятую.
ADMIN_IDS=111111111

# Ключи для юзербота (https://my.telegram.org -> API development tools)
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# Имя файла сессии юзербота (создастся при первом запуске login.py)
TG_SESSION=userbot

# ---------- Доступ ----------
# open — бот доступен всем, кто нажал /start
# private — только ADMIN_IDS и ALLOWED_USER_IDS
ACCESS_MODE=private
ALLOWED_USER_IDS=

# ---------- ИИ-фильтр (необязательно, но сильно режет мусор) ----------
ANTHROPIC_API_KEY=
# Модель для классификации. Для экономии можно поставить claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# ---------- Threads (необязательно) ----------
# Long-lived токен приложения Threads с правом threads_keyword_search
THREADS_ACCESS_TOKEN=
# Как часто опрашивать Threads, в минутах
THREADS_POLL_MINUTES=10

# ---------- Прочее ----------
DB_PATH=data/leadbot.sqlite3
# Не присылать повтор одного и того же текста в течение N часов
DEDUP_HOURS=48
